<launch>
    
    <arg name="rviz" default="true" doc="Запускать Rviz или нет"/>
    <arg name="model" default="burger" doc="Модель робота"/>
    
   
    <include file="$(find super_vichkutkin_study_pkg)/launch/turtlebot3_sim_start.launch">
        <arg name="rviz" value="false" />
    </include>
    
  
    <include file="$(find super_vichkutkin_study_pkg)/launch/turtlebot3_my_gmapping.launch" />
    
   
    <include file="$(find super_vichkutkin_study_pkg)/launch/turtlebot3_move_base.launch">
        <arg name="model" value="$(arg model)" />
    </include>
    
    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" 
          args="-d $(find super_vichkutkin_study_pkg)/rviz/sim_mapping.rviz" />
</launch>
